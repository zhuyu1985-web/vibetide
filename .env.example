# AI Services (DeepSeek via OpenAI-compatible API)
OPENAI_API_KEY=sk-...
OPENAI_API_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# LLM 主 provider 选择（按客户部署需求切换；默认 openai = 上面的 DeepSeek 兼容配置）
#   openai     → 用上面 OPENAI_* 配置（DeepSeek 或任意 OpenAI 兼容端点）
#   dashscope  → 阿里百炼 / 通义千问（见下方 DASHSCOPE_*）
#   zhipu      → 智谱 GLM（见下方 ZHIPU_*）
# LLM_PROVIDER=openai

# 阿里百炼 / 通义千问（DashScope OpenAI 兼容端点；LLM_PROVIDER=dashscope 时启用）
# DASHSCOPE_API_KEY=sk-...
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen-max          # qwen-max / qwen-plus / qwen-turbo / qwen3-max ...

# 智谱 GLM（LLM_PROVIDER=zhipu 时启用；ZHIPU_API_KEY 已在别处配置）
# ZHIPU_MODEL=glm-4

# ===== 对象存储 provider =====
# STORAGE_PROVIDER=volc  # 默认火山 TOS；切腾讯 COS 设 tencent
# 火山引擎 TOS（STORAGE_PROVIDER=volc，默认）
# VOLC_TOS_ACCESS_KEY_ID=
# VOLC_TOS_SECRET_ACCESS_KEY=
# VOLC_TOS_REGION=cn-beijing
# VOLC_TOS_BUCKET=vibetide-media
# VOLC_TOS_ENDPOINT=tos-cn-beijing.volces.com

# 腾讯云 COS（STORAGE_PROVIDER=tencent 时启用；桶需开 public-read）
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_REGION=ap-guangzhou
# COS_BUCKET=vibetide-1250000000   # 桶名含 appid 后缀

# AIGC (kie.ai 聚合 API：文生图/视频/播客)
# KIE_API_KEY=
# KIE_BASE_URL=https://api.kie.ai
