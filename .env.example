# KIE_PODCAST_VOICE_B=Z3R5wn05IrDiVCyEkUrK   # ElevenLabs 音色（主持B）

# Web Search Enhancement
SEARCH_PROVIDER=bocha             # 联网搜索 provider: bocha | tavily (默认 bocha,国内可直连)
BOCHA_API_KEY=sk-...              # 博查 Web Search API (国内可直连主通道)
TAVILY_API_KEY=tvly-...           # Tavily Search API (海外通道,可选)
JINA_API_KEY=jina_...             # Jina Reader API (网页深读主通道) + Embeddings API
JINA_EMBEDDING_MODEL=jina-embeddings-v3  # 知识库向量化模型，默认 jina-embeddings-v3 (1024 维)

# ===== Tikhub 社媒采集 (抖音/微博/小红书/微信公众号/快手/视频号/知乎) =====
TIKHUB_API_KEY=                   # tikhub.io 控制台获取的 Bearer token
# 域名切换:测试环境用海外域名(默认),生产部署到中国大陆需切到 .dev 域名
# - 海外/测试:  https://api.tikhub.io  (默认,无需配置)
# - 国内生产:   https://api.tikhub.dev
TIKHUB_API_BASE_URL=https://api.tikhub.io

# Trending Topics (可配置热榜聚合 API)
TRENDING_API_URL=                 # 热榜 API 地址，如 https://api.tophub.today/...
TRENDING_API_KEY=                 # 热榜 API 密钥
TRENDING_RESPONSE_MAPPING=        # JSON 格式响应映射，如 {"dataPath":"data","fields":{"platform":"source","rank":"rank","title":"title","heat":"heat","url":"url","category":"category"}}

# Inngest
# 生产用 EVENT_KEY/SIGNING_KEY；本地开发建议设 INNGEST_DEV=1。
# 不设 INNGEST_DEV 时 SDK 走 inferred-dev：dev server 没探到会静默回落 Inngest Cloud，
# 用 dummy key 报误导性的「401 Event key not found」（standalone worker 如 dingtalk:stream 易踩）。
# INNGEST_DEV=1               # 本地：事件只发本地 Dev Server(127.0.0.1:8288)，绝不回落 cloud
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ============================================
# Channel Integrations (钉钉/企业微信)
# Optional — configured per-channel via UI instead of env vars
# These fallback env vars are for default testing only
# ============================================

# Site URL for webhook callbacks and mission links
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Note: Actual channel credentials (AppKey, Secret, etc.) are stored
# per-organization in the channel_configs table via the UI at
# /settings/channels. No env vars required for multi-tenant usage.

# ===== CMS (华栖云) =====
CMS_HOST=https://console.demo.chinamcloud.cn/cmsback
CMS_LOGIN_CMC_ID=<从 MMS/CMC 获取；P1 使用测试值 ac51d9649c03fa148b0a6d150e29de12>
CMS_LOGIN_CMC_TID=<从 MMS/CMC 获取；P1 使用测试值 267afa81ecd99962ef229c4bdcc1b33f>
CMS_TENANT_ID=ca37d5448dbf436626c4333df819ec6d
CMS_USERNAME=superAdmin
CMS_DEFAULT_COVER_URL=https://media.demo.chinamcloud.cn/image/default-cover.jpg
CMS_TIMEOUT_MS=15000
CMS_MAX_RETRIES=3

# CMS 默认推送目标（workflow_template 在 cms_publish 步骤可覆盖）
# 缺失时代码回退 81/1768/10210（与历史硬编码一致）
CMS_DEFAULT_SITE_ID=81
CMS_DEFAULT_APP_ID=1768
CMS_DEFAULT_CATALOG_ID=10210

# Feature flag
VIBETIDE_CMS_PUBLISH_ENABLED=false        # Phase 1 默认关闭，逐 org 灰度

# ===== Self-built Auth =====
# AES-256-GCM key for iron-session cookie encryption (≥ 32 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SESSION_SECRET=replace-with-32-byte-random-secret
# Session TTL in seconds (default 7 days)
AUTH_SESSION_TTL_SECONDS=604800
VIBETIDE_CATALOG_SYNC_ENABLED=true        # 栏目同步（cron + 手动）

# ===== Ayrshare social media aggregator (multi-platform external publish) =====
# 一个 API 贯穿 X / Instagram / Facebook / LinkedIn / TikTok / YouTube 等 12+ 平台。
# 文档：https://www.ayrshare.com/docs
AYRSHARE_API_KEY=
AYRSHARE_WEBHOOK_SECRET=                  # HMAC SHA256 验签密钥，与 Ayrshare 控制台一致
AYRSHARE_DEFAULT_PROFILE=                 # Business plan 多账号 profile key（可选）

# ===== ASR 语音识别（IM 语音入口：钉钉/企微语音消息 → 转文本喂对话） =====
ASR_PROVIDER=aliyun               # 多厂家可配: aliyun | tencent（默认 aliyun，国内直连、原生吃 amr）
ASR_MIN_CONFIDENCE=0.6            # 转写置信度门槛，低于则回显让用户确认（防同音字误触发布等危险动作）
# 阿里云智能语音交互 NLS（ASR_PROVIDER=aliyun）
ALIYUN_NLS_APP_KEY=               # NLS 项目 AppKey
ALIYUN_NLS_AK_ID=                # AccessKey ID（自动换 token 用；或直接配 ALIYUN_NLS_TOKEN）
ALIYUN_NLS_AK_SECRET=            # AccessKey Secret
# ALIYUN_NLS_TOKEN=              # 可选：直接配静态 token（开发期快路径，约 24h 有效）
# ALIYUN_NLS_ENDPOINT=https://nls-gateway-cn-shanghai.aliyuncs.com   # 默认上海网关
# 腾讯云 ASR（ASR_PROVIDER=tencent，P0 占位待二期实现）
# TENCENT_ASR_SECRET_ID=        # 可复用 COS_SECRET_ID（同账号）
# TENCENT_ASR_SECRET_KEY=       # 可复用 COS_SECRET_KEY

# ===== 钉钉 Stream 模式接收端（无公网时收 @机器人 消息；pnpm run dingtalk:stream） =====
# 凭证全部在 /settings/channels 的钉钉渠道里配（Client ID + 入站验签密钥/AppSecret），
# 不需要环境变量。worker 只复用 DATABASE_URL 读配置。

# ===== 通义听悟（视频/音频 AI 分析；阿里云控制台建项目拿 AppKey，endpoint 锁 cn-beijing） =====
VIDEO_ANALYSIS_PROVIDER=aliyun_tingwu        # 留空/非此值则 isTingwuEnabled()=false，优雅跳过听悟
ALIBABA_CLOUD_ACCESS_KEY_ID=                 # 阿里云 AccessKey ID（与 AppKey 须同账号/同 RAM 用户）
ALIBABA_CLOUD_ACCESS_KEY_SECRET=             # 阿里云 AccessKey Secret
TINGWU_APP_KEY=                              # 通义听悟控制台「项目」AppKey
